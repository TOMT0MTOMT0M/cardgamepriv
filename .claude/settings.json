{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run test:server:*)",
      "Bash(npm run test:sound)",
      "Bash(npm run test:rolls)",
      "Bash(npm run check:i18n)",
      "Bash(npm run check:images)",
      "Bash(npm run verify)",
      "Bash(npx vitest run:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git tag --list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)"
    ],
    "ask": [
      "Bash(git push origin master:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(npx convex run:*)",
      "Bash(npx convex import:*)"
    ],
    "deny": [
      "Read(./.env.local)",
      "Read(./.env.v2.local)",
      "Read(./.discord-bot-token)",
      "Read(./.feedback-key)",
      "Bash(npm run convex:deploy:*)",
      "Bash(npx convex deploy:*)",
      "Bash(npm run cf:deploy:*)",
      "Bash(npx wrangler pages deploy:*)"
    ]
  }
}
